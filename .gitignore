.DS_Store
# macOS Finder duplicate files (creates "filename 2.ext")
* 2.*
* 3.*
# Generated artifacts (screenshots, smoke output, briefs). One-off local artifacts,
# never inputs: write new scratch output to a temp dir, not here.
artifacts/

*.tsbuildinfo
# Environment files
.env
.env.*
!.env.example

# Playwright artifacts
.playwright-mcp/
.playwright-cli/

# vinext (Next.js plugin)
.vinext/

# Tooling. `.claude/` and `.codex/` are partly tracked (skills, hooks, launch
# config), so ignore only their local state; ignoring the directories outright
# hid every newly added skill from `git status`.
.cmux/
.sisyphus/
.agent/
.claude/settings.local.json
.claude/worktrees/
opencode.json
skills-lock.json

# QA screenshots and snapshot dumps.
# These are one-off local artifacts, never inputs. Keep the repo root scannable:
# write new scratch output to a temp dir, not here.
qa-*.png
homepage-*.png
/*.png
/*.yml
/opencode.json.bak.*

# One-off QA capture dumps (stale artifacts, not inputs)
output/
scratch/
