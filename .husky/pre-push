#!/usr/bin/env sh
# core.hooksPath points at `.husky`, so this tracked file is what git executes directly;
# `.husky/_` is gitignored and a linked worktree would have no hooks otherwise.
# `bun run prepare` re-points hooksPath after husky resets it on install.
#
# The check gate: the GitHub workflows are manual-only, so a skip here means the push is
# unverified. Cloudflare Workers Builds still builds and deploys every push. The task list
# is the `pre-push` preset in scripts/check-tasks.mjs.
#
# Escape hatches:
#   SKIP_PREPUSH=1 git push     # skip just this hook
#   git push --no-verify        # skip all hooks
#
# This worktree is often shared with other sessions, so a failure here can belong to
# someone else's in-flight edit. Check `git status` before assuming it is yours.
[ "$SKIP_PREPUSH" = "1" ] && exit 0

# Git exports these to every hook and every `git` the gate shells out to inherits them,
# which silently redirects those calls at the pushing repository (CLAUDE.md records the
# two tests that caught it). Keep this line.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_QUARANTINE_PATH GIT_REFLOG_ACTION

# Judge the review preflight against what this push sends: the remote sha from the plan
# git writes to stdin. A new branch, a deletion, or a manual run prints nothing and the
# preflight keeps its default base (the merge-base with main).
if [ ! -t 0 ]; then
  push_base=$(bun scripts/pre-push-range.mjs)
  if [ -n "$push_base" ]; then
    REVIEW_HOTSPOT_BASE="$push_base"
    export REVIEW_HOTSPOT_BASE
  fi
fi

bun scripts/run-checks.mjs --preset pre-push
