# The check gate. Not a mirror of CI any more: as of 2026-08-22 the GitHub
# workflows are manual-only, because this private repo's Actions minutes are
# billed and the account stopped paying for them. Nothing else runs lint,
# typecheck, tests, assets, or the review hotspot preflight on the way out, so a
# skip here means the push is unverified. Cloudflare Workers Builds still builds
# and deploys every push, which is the one remote gate left.
#
# Runs concurrently, ~40s.
#
# Escape hatches:
#   SKIP_PREPUSH=1 git push     # skip just this hook
#   git push --no-verify        # skip all hooks
#
# Caveat: this repo's working tree is often shared with other concurrent Claude
# sessions, so a failure here can belong to someone else's in-flight edit rather
# than to what you are pushing. Check `git status` before assuming it is yours.
[ "$SKIP_PREPUSH" = "1" ] && exit 0

bun scripts/run-checks.mjs lint typecheck test assets hotspot-preflight landmarks
