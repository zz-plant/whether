{
  "Whether Repo Skill Template": {
    "scope": "markdown",
    "prefix": "whether-skill",
    "body": [
      "---",
      "name: ${1:skill-name}",
      "description: ${2:One-sentence description of the repeatable workflow this skill covers.}",
      "---",
      "",
      "# ${3:Skill Title}",
      "",
      "${4:One short paragraph stating the skill's purpose and operator value.}",
      "",
      "## Use this skill when",
      "",
      "- ${5:repeatable prompt or task pattern}",
      "- ${6:second valid trigger}",
      "",
      "## Do not use this skill when",
      "",
      "- ${7:non-trigger case}",
      "- ${8:second non-trigger case}",
      "",
      "## Required inputs",
      "",
      "- ${9:required context input}",
      "- ${10:required artifact or repo anchor}",
      "",
      "## Repo anchors",
      "",
      "- `${11:AGENTS.md}`",
      "- `${12:docs/agents/README.md}`",
      "- `${13:.codex/skills/README.md}`",
      "",
      "## Workflow",
      "",
      "1. ${14:first deterministic step}",
      "2. ${15:second deterministic step}",
      "3. ${16:third deterministic step}",
      "4. ${17:finalization step}",
      "",
      "## Output contract",
      "",
      "Return in this order:",
      "",
      "1. **${18:Section one}**",
      "2. **${19:Section two}**",
      "3. **${20:Section three}**",
      "4. **${21:Section four}**",
      "",
      "## Quality checks before finalizing",
      "",
      "- ${22:quality check}",
      "- ${23:quality check}",
      "- ${24:quality check}",
      "",
      "## Guardrails",
      "",
      "- ${25:guardrail}",
      "- ${26:guardrail}",
      "",
      "## Maintenance notes",
      "",
      "- Last reviewed: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "- ${27:Refresh trigger or drift risk.}"
    ],
    "description": "Scaffold a Whether repo-local skill in the repo's preferred structure."
  },
  "Whether Skill Trigger Test": {
    "scope": "markdown",
    "prefix": "whether-skill-test",
    "body": [
      "## Trigger test",
      "",
      "Should use:",
      "- `${1:user prompt that should trigger the skill}`",
      "- `${2:second prompt that should trigger the skill}`",
      "",
      "Should not use:",
      "- `${3:user prompt that should not trigger the skill}`",
      "- `${4:second prompt that should not trigger the skill}`"
    ],
    "description": "Add the repo's preferred trigger-test block to a skill draft."
  }
}
