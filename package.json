{
  "name": "whether",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/vinext-run.mjs dev",
    "build": "node scripts/vinext-run.mjs build",
    "build:fresh": "bun run clean:build && bun run build",
    "build:cloudflare": "node scripts/cloudflare-run.mjs build",
    "build:cloudflare:preview": "node scripts/cloudflare-run.mjs build --env preview",
    "start": "node scripts/vinext-run.mjs start",
    "serve:worker": "wrangler dev --var WHETHER_ENABLE_MOCKUPS:1",
    "clean": "bun scripts/clean-build-artifacts.mjs",
    "clean:build": "bun scripts/clean-build-artifacts.mjs",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "check": "bun scripts/run-checks.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/run-tests.mjs",
    "test:watch": "bun scripts/run-tests.mjs --watch",
    "time-machine:update-summaries": "bun scripts/updateTimeMachineSummariesSince.mjs",
    "mcp:whether": "bun scripts/mcp/whether-mcp-server.ts",
    "deploy:cloudflare": "node scripts/cloudflare-run.mjs deploy",
    "deploy:cloudflare:dry-run": "node scripts/cloudflare-run.mjs deploy --dry-run",
    "deploy:cloudflare:preview": "node scripts/cloudflare-run.mjs deploy --env preview",
    "deploy:cloudflare:preview:dry-run": "node scripts/cloudflare-run.mjs deploy --env preview --dry-run",
    "deploy:cloudflare:branch-check": "node scripts/cloudflare-run.mjs build --env preview && node scripts/cloudflare-run.mjs deploy --env preview --dry-run --skip-build",
    "smoke:prod": "bun scripts/prod-synthetic-smoke.mjs https://whether.work",
    "review:comment-trends": "bun scripts/review-comment-trends.mjs --repo zz-plant/whether --limit 200",
    "review:comment-trends:update": "bun scripts/review-comment-trends.mjs --repo zz-plant/whether --limit 200 --out docs/research/review-comment-trends.latest.json --summary-out docs/research/review-comment-trends.latest.md",
    "review:hotspot-preflight": "bun scripts/review-hotspot-preflight.mjs",
    "check:landmarks": "node scripts/check-main-content-landmarks.mjs",
    "eval:cold-reader": "bun scripts/evals/cold-reader.ts",
    "eval:evidence-retrieval": "bun scripts/evals/evidence-retrieval.ts",
    "agent:doctor": "node scripts/agent-workflow.mjs doctor",
    "agent:route": "node scripts/agent-workflow.mjs route",
    "agent:handoff": "node scripts/agent-workflow.mjs handoff",
    "agent:index": "node scripts/agent-workflow.mjs index",
    "skills:sync": "node scripts/sync-codex-skills.mjs",
    "ui:mockups": "printf '\\nMockups:\\n- http://127.0.0.1:3000/mockups\\n- http://127.0.0.1:3000/mockups/operator-brief?viewport=mobile&density=compact\\n- http://127.0.0.1:3000/mockups/operator-brief?viewport=desktop&density=comfortable\\n\\nFast loop:\\n- bun run ui:iterate -- --only operator-brief-mobile,operator-brief-desktop\\n\\nRun `bun run dev` first if you want a persistent server.\\n'",
    "ui:shots": "node scripts/ui-capture.mjs",
    "ui:shots:list": "node scripts/ui-capture.mjs --list",
    "ui:iterate": "node scripts/ui-iterate.mjs",
    "ui:iterate:list": "node scripts/ui-iterate.mjs --list",
    "ci:screenshot-smoke": "node scripts/ci-screenshot-smoke.mjs",
    "summary-archive:migrate-structured": "bun scripts/migrateSummaryArchiveStructured.ts --write",
    "summary-archive:check-structured": "bun scripts/migrateSummaryArchiveStructured.ts",
    "archive:index": "bun scripts/generatePostureArchiveIndex.ts",
    "brief:freeze": "bun scripts/freezeWeeklyBrief.ts",
    "brief:backfill": "bun scripts/backfillPublishedBriefs.ts",
    "brief:weekly:artifact": "bun scripts/generateWeeklySlackBrief.ts --out artifacts/weekly-slack-brief.txt",
    "seo:page-metrics": "bun scripts/seo-page-metrics.ts",
    "seo:refresh-queue": "bun scripts/seo-refresh-queue.mjs",
    "seo:answers:launch-readiness": "bun scripts/seo-answer-launch-readiness.ts",
    "seo:weekly-runbook": "bun scripts/freezeWeeklyBrief.ts && bun scripts/seo-weekly-runbook.ts",
    "cli:whether": "node scripts/whether-cli.mjs",
    "data:refresh-fallbacks": "bun scripts/refreshFallbackSnapshots.ts",
    "check:vinext": "bun scripts/run-checks.mjs --preset deploy",
    "prepare": "husky && (git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .husky || echo \"[prepare] not a git repository; hooks left unconfigured\")",
    "check:production-edge": "bash scripts/check_production_edge.sh",
    "check:production-assets": "node scripts/verify-prd-assets.mjs https://whether.work",
    "setup": "mise trust && bun install",
    "assets:check": "bun run scripts/check-assets.ts",
    "check:unchecked-access": "bun scripts/check-unchecked-indexed-access.ts",
    "audit": "bun audit --audit-level=critical",
    "assets:generate": "bun run scripts/generate-scenes.ts",
    "assets:visuals": "bun scripts/generate-visual-assets.tsx",
    "assets:video": "bun scripts/generate-brief-video.ts",
    "lint:types": "oxlint --type-aware --deny-warnings",
    "check:suppressions": "bun --bun suppression-census --config scripts/census.config.ts --export suppressionCensusConfig",
    "check:dead-exports": "bun run scripts/check-dead-exports.ts",
    "telemetry:streams": "bun run scripts/telemetry-stream-census.ts",
    "audit:jev-copy": "bun run scripts/jev-copy-audit.ts",
    "audit:near-duplicates": "bun run scripts/near-duplicates.ts",
    "evidence:retrieve": "bun scripts/retrieve-evidence.ts",
    "check:curated-freshness": "bun run scripts/check-curated-freshness.ts",
    "advice-corpus:discover": "bun scripts/advice-corpus/discover.ts",
    "advice-corpus:extract": "bun scripts/advice-corpus/extract.ts",
    "advice-corpus:prefilter": "bun scripts/advice-corpus/prefilter.ts",
    "advice-corpus:classify": "bun scripts/advice-corpus/classify.ts",
    "advice-corpus:validate": "bun scripts/advice-corpus/validate.ts",
    "advice-corpus:analyze": "bun scripts/advice-corpus/analyze.ts",
    "advice-corpus:data": "bun scripts/advice-corpus/siteData.ts",
    "advice-corpus:check": "bun scripts/advice-corpus/siteData.ts --check",
    "reviewed-cases:add": "bun scripts/reviewed-cases.ts add",
    "reviewed-cases:export-eval": "bun scripts/reviewed-cases.ts export-eval",
    "reviewed-cases:list": "bun scripts/reviewed-cases.ts list",
    "evidence:pool": "bun scripts/pool-builder.ts"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@cantoo/pdf-lib": "^2.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "lucide-react": "^1.41.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^5.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vinext/cloudflare": "1.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "bun-test-network-guard": "0.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "8.5.10",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "^4.21.0",
    "suppression-census": "0.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "1.0.1",
    "vite": "^8.2.2",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.129.0"
  },
  "bin": {
    "whether": "./scripts/whether-cli.mjs"
  },
  "overrides": {
    "proxy-addr": "^2.0.8"
  }
}
