{
  "name": "whether",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/repair-vinext-install.mjs",
    "dev": "node scripts/vinext-run.mjs dev",
    "build": "node scripts/vinext-run.mjs build",
    "build:fresh": "bun run clean:build && bun run build",
    "build:cloudflare": "node scripts/cloudflare-run.mjs build",
    "build:cloudflare:preview": "node scripts/cloudflare-run.mjs build --env preview",
    "start": "node scripts/vinext-run.mjs start",
    "clean": "bun scripts/clean-build-artifacts.mjs",
    "clean:build": "bun scripts/clean-build-artifacts.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "check": "bun scripts/run-checks.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/run-tests.mjs",
    "test:watch": "bun scripts/run-tests.mjs --watch",
    "time-machine:update-summaries": "bun scripts/updateTimeMachineSummariesSince.mjs",
    "mcp:whether": "bun scripts/mcp/whether-mcp-server.ts",
    "deploy:cloudflare": "node scripts/cloudflare-run.mjs deploy",
    "deploy:cloudflare:dry-run": "node scripts/cloudflare-run.mjs deploy --dry-run",
    "deploy:cloudflare:preview": "node scripts/cloudflare-run.mjs deploy --env preview",
    "deploy:cloudflare:preview:dry-run": "node scripts/cloudflare-run.mjs deploy --env preview --dry-run",
    "smoke:prod": "bun scripts/prod-synthetic-smoke.mjs https://whether.work",
    "review:comment-trends": "bun scripts/review-comment-trends.mjs --repo zz-plant/whether --limit 200",
    "review:comment-trends:update": "bun scripts/review-comment-trends.mjs --repo zz-plant/whether --limit 200 --out docs/research/review-comment-trends.latest.json --summary-out docs/research/review-comment-trends.latest.md",
    "review:hotspot-preflight": "bun scripts/review-hotspot-preflight.mjs",
    "agent:doctor": "node scripts/agent-workflow.mjs doctor",
    "agent:route": "node scripts/agent-workflow.mjs route",
    "agent:handoff": "node scripts/agent-workflow.mjs handoff",
    "agent:index": "node scripts/agent-workflow.mjs index",
    "agent:prewarm": "node scripts/agent-workflow.mjs prewarm",
    "ui:mockups": "printf '\\nMockups:\\n- http://127.0.0.1:3000/mockups\\n- http://127.0.0.1:3000/mockups/operator-brief?viewport=mobile&density=compact\\n- http://127.0.0.1:3000/mockups/operator-brief?viewport=desktop&density=comfortable\\n\\nFast loop:\\n- bun run ui:iterate -- --only operator-brief-mobile,operator-brief-desktop\\n\\nRun `bun run dev` first if you want a persistent server.\\n'",
    "ui:shots": "node scripts/ui-capture.mjs",
    "ui:shots:list": "node scripts/ui-capture.mjs --list",
    "ui:iterate": "node scripts/ui-iterate.mjs",
    "ui:iterate:list": "node scripts/ui-iterate.mjs --list",
    "summary-archive:migrate-structured": "bun scripts/migrateSummaryArchiveStructured.ts --write",
    "summary-archive:check-structured": "bun scripts/migrateSummaryArchiveStructured.ts",
    "archive:index": "bun scripts/generatePostureArchiveIndex.ts",
    "brief:freeze": "bun scripts/freezeWeeklyBrief.ts",
    "brief:weekly:artifact": "bun scripts/generateWeeklySlackBrief.ts --out artifacts/weekly-slack-brief.txt",
    "seo:refresh-queue": "bun scripts/seo-refresh-queue.mjs",
    "seo:answers:launch-readiness": "bun scripts/seo-answer-launch-readiness.ts",
    "seo:weekly-runbook": "bun scripts/freezeWeeklyBrief.ts && bun scripts/seo-weekly-runbook.ts",
    "cli:whether": "node scripts/whether-cli.mjs",
    "data:refresh-fallbacks": "bun scripts/refreshFallbackSnapshots.ts",
    "check:vinext": "bun run check",
    "prepare": "husky",
    "check:production-edge": "bash scripts/check_production_edge.sh",
    "setup": "mise trust && bun install",
    "assets:check": "bun run scripts/check-assets.ts",
    "assets:generate": "bun run scripts/generate-scenes.ts"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-haptics": "^0.0.6",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vinext/cloudflare": "0.2.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "0.5.32",
    "eslint": "9.38.0",
    "eslint-config-next": "16.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "8.5.10",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "^4.11.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vinext": "0.2.1",
    "vite": "^8.1.0",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.123.0"
  },
  "bin": {
    "whether": "./scripts/whether-cli.mjs"
  }
}