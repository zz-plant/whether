{
  "commands": [
    {
      "name": "Dev",
      "description": "Whether dev server + browser preview",
      "workspace": {
        "name": "Whether Dev",
        "cwd": ".",
        "layout": {
          "direction": "horizontal",
          "children": [
            {
              "pane": {
                "size": 0.45,
                "surfaces": [
                  { "type": "terminal", "name": "Dev Server", "command": "bun run dev" }
                ]
              }
            },
            {
              "pane": {
                "surfaces": [
                  { "type": "browser", "name": "Preview", "url": "http://localhost:3000" },
                  { "type": "terminal", "name": "Terminal" }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "name": "Deploy",
      "description": "Whether deploy to Cloudflare",
      "workspace": {
        "name": "Whether Deploy",
        "cwd": ".",
        "layout": {
          "direction": "horizontal",
          "children": [
            {
              "pane": {
                "size": 0.35,
                "surfaces": [
                  { "type": "terminal", "name": "Deploy", "command": "bun scripts/cloudflare-run.mjs deploy" }
                ]
              }
            },
            {
              "pane": {
                "surfaces": [
                  { "type": "browser", "name": "Prod", "url": "https://whether.work" }
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
