# Whether Environment Variables
# Copy this file to .env.local and fill in your values.

# API Authentication
WHETHER_API_KEY=
WHETHER_TOKEN=
WHETHER_CRON_SECRET=

# Deployment
NEXT_PUBLIC_SITE_URL=https://whether.work
APP_BASE_URL=https://whether.work

# Stripe (optional — for billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=

# Notifications
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
PREMIUM_FUNNEL_WEBHOOK_URL=

# Cloudflare (optional — for deployment)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
